# Dependency directories
node_modules/
**/node_modules/

# Build directories
dist/
**/dist/
build/
**/build/
out/

# Environment variables
.env
.env.examplpe
.env*.local
**/.env
**/.env*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#testing-plugins)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-gyp compilation folder (https://github.com/nodejs/node-gyp)
build/Release

# Dependency directories (npm list -g --depth=0)
jspm_packages

# TypeScript v1.x command line compiler tool cache
tscommand*.tmp.txt

# IntelliJ project files
.idea/
*.iml

# VS Code project files
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# OS metadata files
.DS_Store
Thumbs.db

# Prisma default sqlite or local db copies if any
**/prisma/*.db
**/prisma/*.db-journal
